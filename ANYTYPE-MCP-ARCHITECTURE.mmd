graph TB
    subgraph LAPTOP["Rob's Laptop"]
        CC["Claude Code / IDE"]
        OC_L["OpenClaw (local)"]
        MCP_L["@anyproto/anytype-mcp<br/>MCP Server"]
        SSH_T["SSH Tunnel<br/>localhost:31012 → VPS:31012"]
        AT_APP["AnyType Desktop App"]

        CC -->|"MCP tools"| MCP_L
        OC_L -->|"MCP tools"| MCP_L
        MCP_L -->|"HTTP REST"| SSH_T
    end

    subgraph VPS["VPS — simplemap.safecast.org (65.108.24.131)"]
        subgraph ANYTYPE_CLI["AnyType CLI (anytype-cli.service)"]
            AT_SERVE["anytype serve -q"]
            GRPC["gRPC :31010"]
            HTTP["HTTP API :31012"]
            AT_SERVE --> GRPC
            AT_SERVE --> HTTP
        end

        subgraph OPENCLAW_VPS["OpenClaw (VPS)"]
            OC_V["OpenClaw Agent"]
            MCP_V["@anyproto/anytype-mcp<br/>MCP Server"]
            CRON["Cron: 22:01 UTC<br/>daily-report-api.sh"]
        end

        subgraph SYNC_BACKEND["Self-Hosted Sync Backend"]
            BUNDLE["anytype.service<br/>(any-sync-bundle)"]
            MONGO["MongoDB :27017"]
            REDIS["Redis :6379"]
            BUNDLE --> MONGO
            BUNDLE --> REDIS
        end

        OC_V -->|"MCP tools"| MCP_V
        MCP_V -->|"HTTP REST"| HTTP
        CRON -->|"curl HTTP API"| HTTP
        AT_SERVE -->|"sync protocol"| BUNDLE
    end

    subgraph DEVICES["Other Devices"]
        TABLET["AnyType on Tablet"]
    end

    SSH_T -.->|"SSH port forward"| HTTP
    AT_APP -.->|"sync protocol :33010"| BUNDLE
    TABLET -.->|"sync protocol :33010"| BUNDLE

    classDef laptop fill:#0288d1,stroke:#01579b,stroke-width:2px,color:#fff
